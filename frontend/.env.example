# ============================================
# Shop4Ever Frontend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# In Vite, all env vars must start with VITE_
# IMPORTANT: Never commit .env to version control!
# ============================================

# ---------- Backend API ----------
# URL of the Node.js backend server
VITE_BACKEND_URL=http://localhost:3000

# ---------- Google OAuth ----------
# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---------- Unsplash (product images) ----------
# Fetches real product photos on the consumer dashboard
# Get a free API key at https://unsplash.com/developers
VITE_UNSPLASH_API_KEY=

# ---------- Chatbot Backend (Python) ----------
# URL of the Python chatbot server
# Start it with: cd frontend/src/pages/chatbot && python backend.py
VITE_CHATBOT_API_URL=http://localhost:8000

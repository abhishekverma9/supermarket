# Get a free key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Live supermarket MySQL data via Node.js REST API (optional)
# When set, vector search + structured queries use live DB; otherwise local data.txt/Chroma/SQLite
SUPERMARKET_API_URL=http://localhost:3000
# Optional server-side token (or pass auth_token from the React app per request)
SUPERMARKET_API_TOKEN=
LIVE_DATA_CACHE_TTL=120
LIVE_GRAPH_CACHE_TTL=120
